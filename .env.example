# Paste the Web App URL you get after deploying the Google Apps Script (Code.gs)
# It looks like: https://script.google.com/macros/s/AKfy....../exec
VITE_API_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Optional shared secret. Must match API_TOKEN in the Apps Script (Code.gs).
VITE_API_TOKEN=change-me-to-a-long-random-string
